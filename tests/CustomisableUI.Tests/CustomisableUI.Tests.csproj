<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks for Customisable UI. Run them from the repository root with "dotnet run", pointing it at this project
       folder (tests/CustomisableUI.Tests) in the Release configuration; the README has the exact command.

       It compiles the mod's own source files (rather than referencing the built DLL), so tests can reach internal
       types, and it runs against the real game assemblies, so it needs Bannerlord installed. The install is found the
       same way as for the mod: the BANNERLORD_GAME_DIR environment variable, or the default Steam path. Nothing is
       deployed into the game and no game is launched. The exit code is the number of failed checks. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CustomisableUI.Tests</RootNamespace>
    <AssemblyName>CustomisableUI.Tests</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameFolder Condition="'$(GameFolder)' == ''">$(BANNERLORD_GAME_DIR)</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameBin>$(GameFolder)\bin\Win64_Shipping_Client</GameBin>
    <GameModules>$(GameFolder)\Modules</GameModules>
  </PropertyGroup>

  <!-- The same references as the mod, none copied to the output: the test program finds them in the game folder. -->
  <ItemGroup>
    <Reference Include="$(GameBin)\TaleWorlds.*.dll" Exclude="$(GameBin)\TaleWorlds.Native.dll" Private="false" />
    <Reference Include="$(GameModules)\Native\bin\Win64_Shipping_Client\*.dll" Exclude="$(GameModules)\Native\bin\Win64_Shipping_Client\*AutoGenerated*.dll" Private="false" />
    <Reference Include="$(GameModules)\SandBox\bin\Win64_Shipping_Client\*.dll" Exclude="$(GameModules)\SandBox\bin\Win64_Shipping_Client\*AutoGenerated*.dll" Private="false" />
    <Reference Include="$(GameModules)\StoryMode\bin\Win64_Shipping_Client\*.dll" Exclude="$(GameModules)\StoryMode\bin\Win64_Shipping_Client\*AutoGenerated*.dll" Private="false" />
    <Reference Include="$(GameModules)\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll" Private="false" />
    <Reference Include="$(GameModules)\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll" Private="false" />  </ItemGroup>

  <!-- The mod's source, compiled into this program. -->
  <ItemGroup>
    <Compile Include="..\..\src\CustomisableUI\**\*.cs" Exclude="..\..\src\CustomisableUI\obj\**;..\..\src\CustomisableUI\bin\**" Link="Mod\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
