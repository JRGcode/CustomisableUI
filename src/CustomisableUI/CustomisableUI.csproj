<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mod identity. <Version> is the mod's only version number: it is stamped into the DLL, into SubModule.xml
       (the $version$ token) and into the release zip name. <GameVersion> fills SubModule.xml's $gameversion$ token. -->
  <PropertyGroup>
    <ModuleId>CustomisableUI</ModuleId>
    <Version>1.4.0</Version>
    <GameVersion>v1.4.8</GameVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>$(ModuleId)</AssemblyName>
    <RootNamespace>$(ModuleId)</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Bannerlord install to compile against and deploy into.
       Override with -p:GameFolder="..." or the BANNERLORD_GAME_DIR environment variable. -->
  <PropertyGroup>
    <GameFolder Condition="'$(GameFolder)' == ''">$(BANNERLORD_GAME_DIR)</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameBin>$(GameFolder)\bin\Win64_Shipping_Client</GameBin>
    <GameModules>$(GameFolder)\Modules</GameModules>
    <!-- Copy the assembled module into <GameFolder>\Modules after every build. Pass -p:DeployToGame=false to skip. -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <!-- Compile against the whole game API: the base game plus the official Native, SandBox and StoryMode modules.
       Only assemblies the code actually uses become runtime dependencies, and none are copied to the output.
       War Sails (Modules\NavalDLC) is left out so the mod builds without the DLC; add its bin folder if you need it. -->
  <ItemGroup>
    <Reference Include="$(GameBin)\TaleWorlds.*.dll" Exclude="$(GameBin)\TaleWorlds.Native.dll" Private="false" />
    <Reference Include="$(GameModules)\Native\bin\Win64_Shipping_Client\*.dll" Exclude="$(GameModules)\Native\bin\Win64_Shipping_Client\*AutoGenerated*.dll" Private="false" />
    <Reference Include="$(GameModules)\SandBox\bin\Win64_Shipping_Client\*.dll" Exclude="$(GameModules)\SandBox\bin\Win64_Shipping_Client\*AutoGenerated*.dll" Private="false" />
    <Reference Include="$(GameModules)\StoryMode\bin\Win64_Shipping_Client\*.dll" Exclude="$(GameModules)\StoryMode\bin\Win64_Shipping_Client\*AutoGenerated*.dll" Private="false" />
    <Reference Include="$(GameModules)\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll" Private="false" />
    <!-- Mod Configuration Menu v5: the settings screen this mod is built around. -->
    <Reference Include="$(GameModules)\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll" Private="false" />
  </ItemGroup>

  <!-- Module assembly: <repo>\Module\ holds the non-code files (SubModule.xml, GUI\, ModuleData\...). After each build
       they are combined with the DLL into artifacts\<Configuration>\<ModuleId>\, which is exactly the folder players install. -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <ModuleSourceDir>$(RepoRoot)Module\</ModuleSourceDir>
    <ModuleStagingRoot>$(RepoRoot)artifacts\$(Configuration)\</ModuleStagingRoot>
    <ModuleStagingDir>$(ModuleStagingRoot)$(ModuleId)\</ModuleStagingDir>
  </PropertyGroup>

  <Target Name="AssembleModule" AfterTargets="Build">
    <ItemGroup>
      <!-- Pictures a player (or the developer, testing) has put in Module\Backgrounds\<folder>\ are theirs, not the mod's: a
           Release package carries only the READMEs there. Debug builds keep them so they can be tried in the game. -->
      <_PlayerPicture Condition="'$(Configuration)' == 'Release'" Include="$(ModuleSourceDir)Backgrounds\*\*" Exclude="$(ModuleSourceDir)Backgrounds\*\README.txt" />
      <_ModuleDataFile Include="$(ModuleSourceDir)**\*" Exclude="$(ModuleSourceDir)SubModule.xml;@(_PlayerPicture)" />
      <_ModuleBinary Include="$(TargetPath)" />
      <_ModuleBinary Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <PropertyGroup>
      <_SubModuleXml>$([System.IO.File]::ReadAllText('$(ModuleSourceDir)SubModule.xml').Replace('$version$', 'v$(Version)').Replace('$gameversion$', '$(GameVersion)'))</_SubModuleXml>
    </PropertyGroup>

    <RemoveDir Directories="$(ModuleStagingDir)" />
    <Copy SourceFiles="@(_ModuleDataFile)" DestinationFiles="@(_ModuleDataFile->'$(ModuleStagingDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(ModuleStagingDir)SubModule.xml" Lines="$([MSBuild]::Escape('$(_SubModuleXml)'))" Overwrite="true" />
    <!-- Steam/GOG/Epic load from Win64_Shipping_Client; the Xbox/Game Pass build loads from Gaming.Desktop.x64_Shipping_Client. -->
    <Copy SourceFiles="@(_ModuleBinary)" DestinationFolder="$(ModuleStagingDir)bin\Win64_Shipping_Client\" />
    <Copy SourceFiles="@(_ModuleBinary)" DestinationFolder="$(ModuleStagingDir)bin\Gaming.Desktop.x64_Shipping_Client\" />
    <Message Importance="high" Text="$(ModuleId) v$(Version) -> $(ModuleStagingDir)" />
  </Target>

  <Target Name="DeployModuleToGame" AfterTargets="AssembleModule" Condition="'$(DeployToGame)' == 'true'">
    <Warning Condition="!Exists('$(GameModules)')" Text="Bannerlord not found at '$(GameFolder)'; skipping deploy. Set GameFolder or BANNERLORD_GAME_DIR." />
    <ItemGroup>
      <_StagedModuleFile Include="$(ModuleStagingDir)**\*" />
    </ItemGroup>
    <Copy Condition="Exists('$(GameModules)')" SourceFiles="@(_StagedModuleFile)" DestinationFiles="@(_StagedModuleFile->'$(GameModules)\$(ModuleId)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Condition="Exists('$(GameModules)')" Importance="high" Text="$(ModuleId) deployed -> $(GameModules)\$(ModuleId)" />
  </Target>

  <!-- Release builds also produce the Nexus upload: artifacts\<ModuleId>-v<Version>.zip, with the module folder at its root. -->
  <Target Name="PackageModule" AfterTargets="AssembleModule" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory SourceDirectory="$(ModuleStagingRoot)" DestinationFile="$(RepoRoot)artifacts\$(ModuleId)-v$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="$(ModuleId) packaged -> $(RepoRoot)artifacts\$(ModuleId)-v$(Version).zip" />
  </Target>

</Project>
